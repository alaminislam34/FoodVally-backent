generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
    CUSTOMER
    PROVIDER
    ADMIN
}

enum UserStatus {
    PENDING
    ACTIVE
    BLOCKED
}

enum OrderStatus {
    PENDING
    CONFIRMED
    PREPARING
    OUT_FOR_DELIVERY
    DELIVERED
    CANCELLED
}

enum PaymentMethod {
    COD
    BKASH
    NAGAD
    CARD
}

enum PaymentStatus {
    PENDING
    PAID
    FAILED
}

enum ReportStatus {
    PENDING
    RESOLVED
    DISMISSED
}

// User Model
model User {
    id       String     @id @default(uuid())
    name     String
    username String     @unique
    email    String     @unique
    phone    String?
    password String?
    role     UserRole   @default(CUSTOMER)
    status   UserStatus @default(PENDING)
    avatar   String?

    // Social Login
    googleId String? @unique

    otp          String?
    otpExpiresAt DateTime?
    emailVerifiedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relationships
    restaurants Restaurant[]
    orders      Order[]
    cart        Cart?
    reviews     Review[]
    blogs       Blog[]
    favorites   Favorite[]
    reports     Report[]

    @@map("users")
}

// Restaurant Model
model Restaurant {
    id          String  @id @default(uuid())
    name        String
    slug        String  @unique
    description String?

    // Location
    address String
    city    String?
    lat     Float?
    lng     Float?

    // Branding
    logoUrl  String?
    coverUrl String?

    // Stats and Info
    averageRating Float    @default(0)
    totalReviews  Int      @default(0)
    cuisineTypes  String[] // ["Biriyani", "Chicken"]

    // Delivery Info
    deliveryTime        String?
    deliveryFee         Decimal @default(0)
    minOrderAmount      Decimal @default(0)
    isDeliveryAvailable Boolean @default(true)

    // Operation
    openingHours Json? // Structured opening hours
    isActive     Boolean @default(true)
    isVerified   Boolean @default(false)

    providerId String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    // Relationships
    provider               User                    @relation(fields: [providerId], references: [id])
    foods                  Food[]
    orders                 Order[] // Orders containing items from this restaurant (optional link for filtering)
    reviews                Review[]
    blogRelatedRestaurants BlogRelatedRestaurant[]
    reports                Report[]

    @@map("restaurants")
}

// Category Model
model Category {
    id        String   @id @default(uuid())
    name      String   @unique
    slug      String   @unique
    imageUrl  String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    foods Food[]
    blogs Blog[]

    @@map("categories")
}

// Food Model
model Food {
    id               String  @id @default(uuid())
    name             String
    slug             String  @unique
    description      String?
    shortDescription String?

    price         Decimal
    discountPrice Decimal?
    currency      String   @default("BDT")

    restaurantId String
    categoryId   String

    // Media
    thumbnail String?
    images    String[]

    // Details
    isVeg           Boolean @default(false)
    isSpicy         Boolean @default(false)
    calories        Int?
    preparationTime Int? // Minutes

    // Status
    isAvailable  Boolean  @default(true)
    isFeatured   Boolean  @default(false)
    isBestSeller Boolean  @default(false)
    stock        Int      @default(0)
    tags         String[]

    // SEO
    seo Json? // Meta title, description, keywords

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relationships
    restaurant       Restaurant        @relation(fields: [restaurantId], references: [id])
    category         Category          @relation(fields: [categoryId], references: [id])
    orderItems       OrderItem[]
    cartItems        CartItem[]
    reviews          Review[]
    favorites        Favorite[]
    blogRelatedFoods BlogRelatedFood[]
    reports          Report[]

    @@map("foods")
}

// Order Model
model Order {
    id          String @id @default(uuid())
    orderNumber String @unique // e.g., FDV-20250128-0012
    customerId  String

    restaurantId String? // Optional: if mixed orders are allowed, this can be null
    status       OrderStatus @default(PENDING)

    // Pricing
    subTotal      Decimal
    deliveryFee   Decimal
    serviceCharge Decimal @default(0)
    discount      Decimal @default(0)
    totalAmount   Decimal

    // Payment
    paymentMethod PaymentMethod?
    paymentStatus PaymentStatus  @default(PENDING)
    transactionId String?

    // Delivery Details
    deliveryAddress String? // Or Json if structured
    deliveryCity    String?
    deliveryNote    String?
    estimatedTime   String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relationships
    customer   User        @relation(fields: [customerId], references: [id])
    restaurant Restaurant? @relation(fields: [restaurantId], references: [id]) // Optional linkage
    orderItems OrderItem[]

    @@map("orders")
}

// OrderItem Model
model OrderItem {
    id      String @id @default(uuid())
    orderId String
    foodId  String

    quantity Int
    price    Decimal // Snapshot of price at time of order

    // Snapshot details (optional but good for history)
    name      String?
    thumbnail String?

    // Relationships
    order Order @relation(fields: [orderId], references: [id])
    food  Food  @relation(fields: [foodId], references: [id])

    @@map("order_items")
}

// Cart Model
model Cart {
    id         String   @id @default(uuid())
    customerId String   @unique
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    // Relationships
    customer  User       @relation(fields: [customerId], references: [id])
    cartItems CartItem[]

    @@map("carts")
}

// CartItem Model
model CartItem {
    id        String   @id @default(uuid())
    cartId    String
    foodId    String
    quantity  Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relationships
    cart Cart @relation(fields: [cartId], references: [id])
    food Food @relation(fields: [foodId], references: [id])

    @@unique([cartId, foodId]) // Prevent duplicate items in same cart
    @@map("cart_items")
}

// Favorite Model
model Favorite {
    id         String   @id @default(uuid())
    customerId String
    foodId     String
    createdAt  DateTime @default(now())

    customer User @relation(fields: [customerId], references: [id])
    food     Food @relation(fields: [foodId], references: [id])

    @@unique([customerId, foodId]) // Unique favorite per user per food
    @@map("favorites")
}

// Blog Model
model Blog {
    id        String  @id @default(uuid())
    title     String
    slug      String  @unique
    excerpt   String?
    content   String
    thumbnail String?
    videoUrl  String?

    authorId   String
    categoryId String?

    tags        String[]
    publishedAt DateTime?
    status      String    @default("draft") // published, draft

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    author      User                    @relation(fields: [authorId], references: [id])
    category    Category?               @relation(fields: [categoryId], references: [id])
    restaurants BlogRelatedRestaurant[]
    foods       BlogRelatedFood[]

    @@map("blogs")
}

// Blog Linked to Restaurant
model BlogRelatedRestaurant {
    blogId       String
    restaurantId String

    blog       Blog       @relation(fields: [blogId], references: [id])
    restaurant Restaurant @relation(fields: [restaurantId], references: [id])

    @@id([blogId, restaurantId])
    @@map("blog_related_restaurants")
}

// Blog Linked to Food
model BlogRelatedFood {
    blogId String
    foodId String

    blog Blog @relation(fields: [blogId], references: [id])
    food Food @relation(fields: [foodId], references: [id])

    @@id([blogId, foodId])
    @@map("blog_related_foods")
}

// Review Model
model Review {
    id           String   @id @default(uuid())
    customerId   String
    foodId       String?
    restaurantId String?
    rating       Float    @default(5) // 1.0 - 5.0
    comment      String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    customer   User        @relation(fields: [customerId], references: [id])
    food       Food?       @relation(fields: [foodId], references: [id])
    restaurant Restaurant? @relation(fields: [restaurantId], references: [id])

    @@map("reviews")
}

// Report Model
model Report {
    id String @id @default(uuid())

    reporterId String
    reporter   User   @relation(fields: [reporterId], references: [id])

    // Target (Polymorphic-ish via separate FKs)
    foodId String?
    food   Food?   @relation(fields: [foodId], references: [id])

    restaurantId String?
    restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])

    issueType String
    reason    String?

    evidenceImages String[]
    note           String?

    status ReportStatus @default(PENDING)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("reports")
}
